# .orchestrator.env: cấu hình worker. Commit được, KHÔNG để secret ở đây.
# API key và thiết lập cá nhân: đặt trong .orchestrator.env.local (đã gitignore).
# File này được `eval` nên hãy review như một script.

# Worker được phép dùng (tên chỉ gồm chữ, số, dấu gạch ngang) và worker mặc định
WORKERS="cursor ollama claude"
DEFAULT_WORKER="cursor"

# Mỗi worker khai báo theo mẫu WORKER_<TÊN>_*  (tên viết hoa, gạch ngang → gạch dưới)
#   _CMD    : mẫu lệnh, chạy trong worktree của task.
#             @PROMPT_FILE@ = file prompt (task + quy tắc), @MODEL@ = model được chọn.
#             Từ đầu tiên của _CMD phải là tên công cụ (preflight dùng nó để kiểm tra đã cài chưa).
#   _MODEL  : model mặc định (task có thể ghi đè bằng dòng "Model:")
#   _UPDATE : lệnh cập nhật (tùy chọn, chạy khi dùng preflight --update-tools)
#   _HINT   : mô tả khi nào nên dùng, để agent điều phối chọn worker phù hợp
# Biến môi trường (vd OLLAMA_API_BASE) đặt bằng `export` riêng, không viết VAR=... trước _CMD.
# Cờ của các công cụ có thể đổi theo phiên bản: kiểm tra bằng `<công cụ> --help`.

# ───────────────────────────────────────────────────────────────
# 1) Cursor CLI: đăng nhập sẵn trong công cụ, tốn hạn mức Cursor
# ───────────────────────────────────────────────────────────────
WORKER_CURSOR_CMD='cursor-agent -p --force "$(cat "@PROMPT_FILE@")"'
# Muốn chọn model: thêm `--model @MODEL@` vào _CMD và điền WORKER_CURSOR_MODEL
WORKER_CURSOR_UPDATE="cursor-agent update"
WORKER_CURSOR_HINT="Việc cần đọc nhiều file, UI, refactor vừa; tốn hạn mức Cursor"

# ───────────────────────────────────────────────────────────────
# 2) Ollama (model local, miễn phí) chạy qua aider làm agent runner
#    Ollama chỉ chạy model, không tự sửa file, nên cần aider (pip install aider-chat).
#    Cần: ollama đang chạy và đã `ollama pull` model bên dưới.
# ───────────────────────────────────────────────────────────────
export OLLAMA_API_BASE="http://127.0.0.1:11434"
WORKER_OLLAMA_CMD='aider --model @MODEL@ --message-file "@PROMPT_FILE@" --yes-always --no-auto-commits'
WORKER_OLLAMA_MODEL="ollama_chat/qwen2.5-coder:14b"
# Giữ tên model sau `ollama pull` trùng với WORKER_OLLAMA_MODEL (bỏ tiền tố ollama_chat/)
WORKER_OLLAMA_UPDATE="ollama pull qwen2.5-coder:14b"
WORKER_OLLAMA_HINT="Việc cơ học, nhỏ, phạm vi hẹp, có file mẫu; chạy local, miễn phí"

# ───────────────────────────────────────────────────────────────
# 3) Claude Code chế độ không tương tác, model nhẹ hơn model điều phối
#    Cần: đã đăng nhập Claude Code. CHÚ Ý: nếu đặt ANTHROPIC_API_KEY thì sẽ tính phí theo API
#    thay vì hạn mức gói; chỉ đặt biến đó trong .orchestrator.env.local khi bạn muốn vậy.
#    Quyền: acceptEdits chỉ cho sửa file. Để worker chạy được test, thêm lệnh test của project vào
#    --allowedTools, ví dụ:  "Bash(flutter test:*)"  hoặc  "Bash(npm test:*)"
# ───────────────────────────────────────────────────────────────
WORKER_CLAUDE_CMD='claude -p "$(cat "@PROMPT_FILE@")" --model @MODEL@ --permission-mode acceptEdits --max-turns 30 --allowedTools "Read" "Edit" "Write" "Glob" "Grep"'
WORKER_CLAUDE_MODEL="haiku"
# Bí danh `haiku`/`sonnet` luôn trỏ tới bản mới nhất. Muốn ghim bản: claude-haiku-5-5, claude-sonnet-5-5.
# Task khó hơn: ghi `Model: sonnet` ở đầu task file để nâng riêng task đó.
WORKER_CLAUDE_HINT="Việc cơ học cần hiểu ngữ cảnh tốt hơn model local; rẻ hơn model điều phối"
